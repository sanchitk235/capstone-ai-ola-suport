# ─────────────────────────────────────────────────────────────
# Ola Support Agent — Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in values as needed.
# All defaults below run the system in zero-API-key MOCK_LLM mode.

# ── LLM mode ──────────────────────────────────────────────────
# Set to "real" to use a real LLM (requires OPENAI_API_KEY or similar)
LLM_MODE=mock

# ── (Optional) Real LLM settings — only used when LLM_MODE=real ──
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# ── CrewAI telemetry — must be disabled for zero-network mode ──
CREWAI_DISABLE_TELEMETRY=true
OTEL_SDK_DISABLED=true

# ── FastAPI server ─────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── RAG settings ───────────────────────────────────────────────
COLLECTION_NAME=ola_sentence
TOP_K=3
GROUNDEDNESS_THRESHOLD=0.40

# ── Governance ─────────────────────────────────────────────────
MAX_TOKENS_PER_REQUEST=500
